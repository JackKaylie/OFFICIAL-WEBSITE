rules_version = '2';
service firebase.storage {
	match /b/{bucket}/o {
		function isDrawingAdmin() {
			return request.auth != null
				&& request.auth.uid == 'YG3rLqNo5jMz4muX0kxZkwumL443';
		}

		match /drawing-references/{userId}/{fileName} {
			allow read: if true;
			allow create, update: if isDrawingAdmin()
				&& request.resource.size <= 10 * 1024 * 1024
				&& request.resource.contentType.matches('image/(jpeg|png|webp)');
			allow delete: if isDrawingAdmin();
		}

		match /music/{trackId}/{fileName} {
			allow read: if true;
			allow create, update: if isDrawingAdmin()
				&& (
					(fileName.matches('audio\\.(mp3|wav|m4a|ogg)')
						&& request.resource.size <= 100 * 1024 * 1024
						&& request.resource.contentType.matches('audio/(mpeg|wav|x-wav|mp4|ogg)'))
					|| (fileName.matches('cover\\.(jpg|jpeg|png|webp)')
						&& request.resource.size <= 10 * 1024 * 1024
						&& request.resource.contentType.matches('image/(jpeg|png|webp)'))
				);
			allow delete: if isDrawingAdmin();
		}
	}
}