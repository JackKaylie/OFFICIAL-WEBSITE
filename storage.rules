rules_version = '2';
service firebase.storage {
	match /b/{bucket}/o {
		function isDrawingAdmin() {
			return request.auth != null
				&& request.auth.uid == 'YG3rLqNo5jMz4muX0kxZkwumL443';
		}

		match /drawing-references/{userId}/{fileName} {
			allow read: if true;
			allow create, update: if isDrawingAdmin()
				&& request.resource.size <= 10 * 1024 * 1024
				&& request.resource.contentType.matches('image/(jpeg|png|webp)');
			allow delete: if isDrawingAdmin();
		}
	}
}